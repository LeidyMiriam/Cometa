<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<ScrollPane fitToWidth="true" minHeight="700" minWidth="400.0" prefHeight="750" prefWidth="400.0" style="-fx-background-color: #12080a; -fx-background: #12080a;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="PaqueteLibrerias.ConfPerfilController">
    <VBox alignment="TOP_CENTER" spacing="20" style="-fx-padding: 25; -fx-background-color: #12080a;">
        
        <HBox alignment="CENTER" spacing="10">
            <Label style="-fx-text-fill: #ff3366; -fx-font-size: 26px; -fx-font-weight: bold;" text="💫 Cometa 💫" />
        </HBox>

        <VBox maxWidth="380" spacing="16" style="-fx-background-color: #1f0f14; -fx-padding: 25; -fx-background-radius: 15;">
         <Button fx:id="botonAPrincipal" maxWidth="Infinity" onAction="#onBotonAPrincipalAction" style="-fx-background-color: #ff3366; -fx-text-fill: #ffffff; -fx-font-weight: bold; -fx-font-size: 14px; -fx-padding: 10; -fx-background-radius: 8;" text="Regresar a pagina Principal" />
            
            <Label style="-fx-text-fill: #ffffff; -fx-font-size: 18px; -fx-font-weight: bold;" text="Configuración de Perfil" />
            
            <Separator style="-fx-background-color: #3d1c27;" />

            <VBox alignment="CENTER" spacing="10">
                <Label style="-fx-text-fill: #fcd5ce; -fx-font-weight: bold;" text="Foto de Perfil" />
                <StackPane>
                    <Circle fill="#2e161f" radius="45" stroke="#ff3366" strokeType="INSIDE" strokeWidth="2" />
                    <Label style="-fx-text-fill: #8c6875; -fx-font-size: 11px;" text="Foto" />
                </StackPane>
                <Button fx:id="botonCambiaFoto" style="-fx-background-color: #2e161f; -fx-text-fill: #ff3366; -fx-border-color: #ff3366; -fx-border-radius: 5; -fx-background-radius: 5;" text="Cambiar foto" />
            </VBox>

            <Separator style="-fx-background-color: #3d1c27;" />

            <Label style="-fx-text-fill: #ff3366; -fx-font-weight: bold; -fx-font-size: 14px;" text="Información Personal" />
            
            <VBox spacing="6">
                <Label style="-fx-text-fill: #fcd5ce;" text="Nombre completo" />
                <TextField fx:id="cuadroMiNombreReal" promptText="Ej. McLovin" style="-fx-background-color: #2e161f; -fx-text-fill: #ffffff; -fx-prompt-text-fill: #8c6875; -fx-background-radius: 5;" />
            </VBox>

            <VBox spacing="6">
                <Label style="-fx-text-fill: #fcd5ce;" text="Alias / Username" />
                <TextField fx:id="cuadroMiAlias" promptText="Ej. @yo_soy_mclovin" style="-fx-background-color: #2e161f; -fx-text-fill: #ffffff; -fx-prompt-text-fill: #8c6875; -fx-background-radius: 5;" />
            </VBox>

            <VBox spacing="6">
                <Label style="-fx-text-fill: #fcd5ce;" text="Edad" />
            <DatePicker />
            </VBox>

            <VBox spacing="6">
                <Label style="-fx-text-fill: #fcd5ce;" text="Dirección" />
                <TextField fx:id="cuadroMiDireccion" promptText="Ciudad, País" style="-fx-background-color: #2e161f; -fx-text-fill: #ffffff; -fx-prompt-text-fill: #8c6875; -fx-background-radius: 5;" />
            </VBox>

            <VBox spacing="8">
                <Label style="-fx-text-fill: #fcd5ce;" text="Mi Género" />
                <HBox spacing="15">
                    <RadioButton selected="true" style="-fx-text-fill: #fcd5ce;" text="Masculino">
                        <toggleGroup>
                            <ToggleGroup fx:id="grupoGenero" />
                        </toggleGroup>
                    </RadioButton>
                    <RadioButton style="-fx-text-fill: #fcd5ce;" text="Femenino" toggleGroup="$grupoGenero" />
                    <RadioButton style="-fx-text-fill: #fcd5ce;" text="Otro" toggleGroup="$grupoGenero" />
                </HBox>
                <TextField fx:id="cuadroSoyOtroGenero" promptText="Especificar otro género" style="-fx-background-color: #2e161f; -fx-text-fill: #ffffff; -fx-prompt-text-fill: #8c6875; -fx-background-radius: 5;" />
            </VBox>

            <Separator style="-fx-background-color: #3d1c27;" />

            <Label style="-fx-text-fill: #ff3366; -fx-font-weight: bold; -fx-font-size: 14px;" text="Publicaciones y Descripción" />

            <VBox spacing="6">
                <Label style="-fx-text-fill: #fcd5ce;" text="Descripción de Perfil" />
                <TextArea fx:id="cuadroDescripcion" prefHeight="70" promptText="Escribe algo sobre ti..." style="-fx-background-color: #2e161f; -fx-text-fill: #8c6875; -fx-prompt-text-fill: #8c6875;" wrapText="true" />
            </VBox>

            <VBox spacing="6">
                <Label style="-fx-text-fill: #fcd5ce;" text="Etiquetas (#Hashtags)" />
                <TextField fx:id="cuadroIngresarTags" promptText="Ej. #Gaming #Programacion #Musica" style="-fx-background-color: #2e161f; -fx-text-fill: #ffffff; -fx-prompt-text-fill: #8c6875; -fx-background-radius: 5;" />
            </VBox>

            <VBox spacing="8">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label fx:id="botonAgregar" style="-fx-text-fill: #fcd5ce; -fx-font-weight: bold;" text="Agregar Fotos / Videos / Publicaciones" />
                    <Button style="-fx-background-color: #ff3366; -fx-text-fill: #ffffff; -fx-font-weight: bold; -fx-background-radius: 15;" text="+" />
                </HBox>
            </VBox>

            <VBox spacing="8">
                <Label style="-fx-text-fill: #fcd5ce;" text="Publicaciones realizadas" />
                
                <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-background-color: #2e161f; -fx-padding: 8; -fx-background-radius: 5;">
                    <Label style="-fx-text-fill: #ffffff;" text="Foto_1.png" HBox.hgrow="ALWAYS" />
                    <Button fx:id="botonEditarF" style="-fx-background-color: #4a2331; -fx-text-fill: #fcd5ce; -fx-font-size: 11px;" text="Editar" />
                    <Button fx:id="BotonEliminarF" style="-fx-background-color: #801d2e; -fx-text-fill: #ffffff; -fx-font-size: 11px;" text="Eliminar" />
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-background-color: #2e161f; -fx-padding: 8; -fx-background-radius: 5;">
                    <Label style="-fx-text-fill: #ffffff;" text="Video_promo.mp4" HBox.hgrow="ALWAYS" />
                    <Button fx:id="botonEditarV" style="-fx-background-color: #4a2331; -fx-text-fill: #fcd5ce; -fx-font-size: 11px;" text="Editar" />
                    <Button fx:id="botonEliminarV" style="-fx-background-color: #801d2e; -fx-text-fill: #ffffff; -fx-font-size: 11px;" text="Eliminar" />
                </HBox>
            </VBox>

            <Separator style="-fx-background-color: #3d1c27;" />

            <Label style="-fx-text-fill: #ff3366; -fx-font-weight: bold; -fx-font-size: 14px;" text="Preferencias de Búsqueda" />

            <VBox spacing="8">
                <Label style="-fx-text-fill: #fcd5ce;" text="Estoy buscando el género:" />
                <HBox spacing="15">
                    <RadioButton selected="true" style="-fx-text-fill: #fcd5ce;" text="Femenino">
                        <toggleGroup>
                            <ToggleGroup fx:id="grupoBusquedaGenero" />
                        </toggleGroup>
                    </RadioButton>
                    <RadioButton style="-fx-text-fill: #fcd5ce;" text="Masculino" toggleGroup="$grupoBusquedaGenero" />
                    <RadioButton style="-fx-text-fill: #fcd5ce;" text="Otro" toggleGroup="$grupoBusquedaGenero" />
                </HBox>
                <TextField fx:id="cuadroOtroBuscoGenero" promptText="Otro género a buscar" style="-fx-background-color: #2e161f; -fx-text-fill: #ffffff; -fx-prompt-text-fill: #8c6875; -fx-background-radius: 5;" />
            </VBox>

            <VBox spacing="6">
                <Label style="-fx-text-fill: #fcd5ce;" text="Rango de edad a buscar" />
                <Slider majorTickUnit="20" max="99" min="18" showTickLabels="true" showTickMarks="true" value="25" />
            </VBox>

            <VBox spacing="6">
                <Label style="-fx-text-fill: #fcd5ce;" text="Buscar por ciertos #" />
                <TextField fx:id="cuadroBuscarTags" promptText="Ej. #Deportes #Fotografia" style="-fx-background-color: #2e161f; -fx-text-fill: #ffffff; -fx-prompt-text-fill: #8c6875; -fx-background-radius: 5;" />
            </VBox>

            <Button fx:id="botonGuardar" maxWidth="Infinity" onAction="#onBotonGuardarAction" style="-fx-background-color: #ff3366; -fx-text-fill: #ffffff; -fx-font-weight: bold; -fx-font-size: 14px; -fx-padding: 10; -fx-background-radius: 8;" text="Guardar Cambios">
                <VBox.margin>
                    <Insets top="10.0" />
                </VBox.margin>
            </Button>

        </VBox>
    </VBox>
</ScrollPane>
