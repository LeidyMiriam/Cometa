<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane minHeight="700" minWidth="400" prefHeight="700" prefWidth="400" style="-fx-background-color: #12080a;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1">
    <top>
        <HBox fx:id="onBotonAPerfilMnAction" alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 15; -fx-background-color: #1f0f14;">
            <Label style="-fx-text-fill: #ff3366; -fx-font-size: 18px; -fx-font-weight: bold;" text="💫  Cometa 💫" />
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="botonAPerfil" onAction="#onBotonAPerfilAction" style="-fx-background-color: #b82355; -fx-text-fill: #ffffff;" text="Perfil" />
            <Button fx:id="botonOpciones" onAction="#onBotonOpcionesAction" style="-fx-background-color: #1f0f14; -fx-text-fill: #ff3366; -fx-border-color: #ff3366;" text="Opciones" />
        </HBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: #12080a; -fx-background: #12080a; -fx-padding: 10;">
            <VBox spacing="12" style="-fx-padding: 10;">
                <HBox alignment="CENTER_LEFT">
                    <Label style="-fx-background-color: #2e161f; -fx-text-fill: #ffffff; -fx-padding: 10 14; -fx-background-radius: 15 15 15 2;" text="Hola! Como estás?" />
                </HBox>
                <HBox alignment="CENTER_RIGHT">
                    <Label style="-fx-background-color: #b82355; -fx-text-fill: #ffffff; -fx-padding: 10 14; -fx-background-radius: 15 15 2 15;" text="Hola! Todo bien, y tú?" />
                </HBox>
                <HBox alignment="CENTER_LEFT">
                    <Label style="-fx-background-color: #2e161f; -fx-text-fill: #ffffff; -fx-padding: 10 14; -fx-background-radius: 15 15 15 2;" text="Te gustaría salir a jugar D&amp;D?" />
                </HBox>
                <HBox alignment="CENTER_RIGHT">
                    <Label style="-fx-background-color: #b82355; -fx-text-fill: #ffffff; -fx-padding: 10 14; -fx-background-radius: 15 15 2 15;" text="Claro! Me encantaría." />
                </HBox>
            </VBox>
        </ScrollPane>
    </center>
    <bottom>
        <VBox>
            <HBox spacing="10" style="-fx-padding: 15; -fx-background-color: #1f0f14;">
                <TextField fx:id="cuadroEnviarMensaje" onKeyTyped="#onCuadroEnviarMensajeKeyTyped" promptText="Escribe un mensaje..." style="-fx-background-color: #2e161f; -fx-text-fill: #ffffff; -fx-prompt-text-fill: #8c6875;" HBox.hgrow="ALWAYS" />
                <Button fx:id="botonEnviar" onAction="#onBotonEnviarAction" style="-fx-background-color: #ff3366; -fx-text-fill: #ffffff;" text="Enviar" />
            </HBox>
            <HBox alignment="CENTER" spacing="10" style="-fx-padding: 12; -fx-background-color: #1f0f14;">
                <Button fx:id="botonALikesMn" onAction="#onBotonALikesMnAction" style="-fx-background-color: #2e161f; -fx-text-fill: #fcd5ce; -fx-background-radius: 8;" text="Likes" />
                <Button fx:id="botonAMensajesMn" onAction="#onBotonAMensajesMnAction" style="-fx-background-color: #b82355; -fx-text-fill: #ffffff; -fx-font-weight: bold; -fx-background-radius: 8;" text="Mensajes" />
                <Button fx:id="botonAPerfilMn" onAction="#onBotonAPerfilMnAction" style="-fx-background-color: #2e161f; -fx-text-fill: #fcd5ce; -fx-background-radius: 8;" text="Perfil" />
                <Button fx:id="botonAConfiguracionMn" onAction="#onBotonAConfiguracionMnAction" style="-fx-background-color: #2e161f; -fx-text-fill: #fcd5ce; -fx-background-radius: 8;" text="Configuración" />
            </HBox>
        </VBox>
    </bottom>
</BorderPane>
