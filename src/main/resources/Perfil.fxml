<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<BorderPane minHeight="700" minWidth="400" prefHeight="700" prefWidth="400" style="-fx-background-color: #12080a;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1">
    <top>
        <HBox alignment="CENTER" spacing="10" style="-fx-padding: 15; -fx-background-color: #1f0f14;">
            <Label style="-fx-text-fill: #ff3366; -fx-font-size: 22px; -fx-font-weight: bold;" text="💫 Cometa 💫" />
        </HBox>
    </top>
    <center>
        <VBox alignment="TOP_CENTER" spacing="15" style="-fx-padding: 20;">
            <VBox alignment="CENTER" maxWidth="340" spacing="14" style="-fx-background-color: #1f0f14; -fx-padding: 25; -fx-background-radius: 15;">

                <StackPane>
                    <Circle fill="#2e161f" radius="55" stroke="#ff3366" strokeType="INSIDE" strokeWidth="2" />
                    <Label style="-fx-text-fill: #8c6875; -fx-font-size: 11px;" text="Foto" />
                </StackPane>

                <Label style="-fx-text-fill: #ffffff; -fx-font-size: 20px; -fx-font-weight: bold;" text="Nombre, Edad" />

                <Separator style="-fx-background-color: #3d1c27;" />

                <Label style="-fx-text-fill: #fcd5ce; -fx-wrap-text: true;" text="Escribe algo sobre ti..." wrapText="true" />

                <HBox alignment="CENTER" spacing="8">
                    <Label style="-fx-text-fill: #ff3366; -fx-background-color: #2e161f; -fx-padding: 6 12; -fx-background-radius: 15; -fx-font-size: 12px;" text="#Gaming" />
                    <Label style="-fx-text-fill: #ff3366; -fx-background-color: #2e161f; -fx-padding: 6 12; -fx-background-radius: 15; -fx-font-size: 12px;" text="#Programacion" />
                    <Label style="-fx-text-fill: #ff3366; -fx-background-color: #2e161f; -fx-padding: 6 12; -fx-background-radius: 15; -fx-font-size: 12px;" text="#Musica" />
                </HBox>

                <Separator style="-fx-background-color: #3d1c27;" />

                <Button fx:id="botonConfiguraPerfil" maxWidth="Infinity" onAction="#onBotonConfiguraPe" style="-fx-background-color: #ff3366; -fx-text-fill: #ffffff; -fx-font-weight: bold; -fx-padding: 10; -fx-background-radius: 8;" text="Configurar Perfil" />
            </VBox>
        </VBox>
    </center>
    <bottom>
        <HBox alignment="CENTER" spacing="10" style="-fx-padding: 12; -fx-background-color: #1f0f14;">
            <Button fx:id="botonALikesPe" onAction="#onBotonALikesPeAction" style="-fx-background-color: #2e161f; -fx-text-fill: #fcd5ce; -fx-background-radius: 8;" text="Likes" />
            <Button fx:id="botonAMensajesPe" onAction="#onBotonAMensajesPeAction" style="-fx-background-color: #2e161f; -fx-text-fill: #fcd5ce; -fx-background-radius: 8;" text="Mensajes" />
            <Button fx:id="botonAPerfilPe" onAction="#onBotonAPerfilPeAction" style="-fx-background-color: #b82355; -fx-text-fill: #ffffff; -fx-font-weight: bold; -fx-background-radius: 8;" text="Perfil" />
            <Button fx:id="botonAConfiguracionPe" onAction="#onBotonAConfiguracionPeAction" style="-fx-background-color: #2e161f; -fx-text-fill: #fcd5ce; -fx-background-radius: 8;" text="Configuración" />
        </HBox>
    </bottom>
</BorderPane>
