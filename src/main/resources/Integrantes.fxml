<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane minHeight="700" minWidth="400.0" prefHeight="700" prefWidth="400.0" style="-fx-background-color: #12080a;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1">
    <top>
        <HBox alignment="CENTER" spacing="10" style="-fx-padding: 15; -fx-background-color: #1f0f14;">
            <Label style="-fx-text-fill: #ff3366; -fx-font-size: 20px; -fx-font-weight: bold;" text="Equipo de Desarrollo" />
        </HBox>
    </top>
    <center>
        <VBox alignment="CENTER" spacing="15" style="-fx-padding: 25;">
            <VBox alignment="CENTER_LEFT" maxWidth="320" spacing="14" style="-fx-background-color: #1f0f14; -fx-padding: 30; -fx-background-radius: 15;">
                <Label style="-fx-text-fill: #fcd5ce; -fx-font-size: 16px;" text="1. Leidy Miriam Morayta Perez" />
                <Separator style="-fx-background-color: #3d1c27;" />
                <Label style="-fx-text-fill: #fcd5ce; -fx-font-size: 16px;" text="2. Angela Alicia Pimienta Diaz" />
                <Separator style="-fx-background-color: #3d1c27;" />
                <Label style="-fx-text-fill: #fcd5ce; -fx-font-size: 16px;" text="3. Victor Adrian Romero Minaya" />
                <Separator style="-fx-background-color: #3d1c27;" />
                <Label style="-fx-text-fill: #fcd5ce; -fx-font-size: 16px;" text="4. Diego Valadez Almeyda" />
            </VBox>
         <Button fx:id="botonAPrncipalIn" mnemonicParsing="false" onAction="#onBotonAPrncipalInAction" style="-fx-background-color: #ff3366; -fx-text-fill: #ffffff; -fx-font-weight: bold; -fx-background-radius: 8;" text="Principal" />
        </VBox>
    </center>
</BorderPane>
