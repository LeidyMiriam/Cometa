<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" minHeight="700" minWidth="400" prefHeight="700" prefWidth="400" spacing="15.0" style="-fx-background-color: #12080a; -fx-padding: 25;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="PaqueteLibrerias.RegistroController">
    <Label style="-fx-text-fill: #ff3366; -fx-font-size: 30px; -fx-font-weight: bold;" text="💫 Cometa 💫" />
    <Label style="-fx-text-fill: #fcd5ce; -fx-font-size: 20px;" text="Registro" />
    <VBox maxWidth="300" spacing="10" style="-fx-background-color: #1f0f14; -fx-padding: 20; -fx-background-radius: 10;">
        <Label style="-fx-text-fill: #fcd5ce;" text="Correo" />
        <TextField fx:id="cuadroCorreo" promptText="correo" style="-fx-background-color: #2e161f; -fx-text-fill: #ffffff; -fx-prompt-text-fill: #8c6875; -fx-background-radius: 5;" />
        <Label style="-fx-text-fill: #fcd5ce;" text="Contraseña" />
        <PasswordField fx:id="cuadroContrasena" promptText="contraseña" style="-fx-background-color: #2e161f; -fx-text-fill: #ffffff; -fx-prompt-text-fill: #8c6875; -fx-background-radius: 5;" />
        <Label style="-fx-text-fill: #fcd5ce;" text="Confirmar Contraseña" />
        <PasswordField fx:id="cuadroContrasena2" promptText="contraseña" style="-fx-background-color: #2e161f; -fx-text-fill: #ffffff; -fx-prompt-text-fill: #8c6875; -fx-background-radius: 5;" />
        <CheckBox style="-fx-text-fill: #fcd5ce;" text="Acepto el aviso de privacidad" wrapText="true" />
        <Button fx:id="botonRegistro" maxWidth="Infinity" onAction="#onBotonRegistro" style="-fx-background-color: #ff3366; -fx-text-fill: #ffffff; -fx-font-weight: bold; -fx-padding: 10; -fx-background-radius: 8;" text="Siguiente" />
    </VBox>
    <Button fx:id="botonInicioSesion" onAction="#onBotonInicioSesion" style="-fx-background-color: transparent; -fx-text-fill: #b82355;" text="¿Ya tienes cuenta? Inicia sesión" />
</VBox>
